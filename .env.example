# ==========================================
# 1. KI & TOKEN-TRACKING (Erforderlich für KI-Analyse & Token-Kosten)
# ==========================================
# Tragen Sie hier Ihren Google Gemini API Key ein.
# Das Backend akzeptiert flexibel: GEMINI_API_KEY (Standard), GOOGLE_API_KEY oder API_KEY.
# Hinweis: KEINE VITE_ Präfixe verwenden, damit der Schlüssel niemals im Browser sichtbar wird!
GEMINI_API_KEY="MY_GEMINI_API_KEY"
# GOOGLE_API_KEY=
# API_KEY=

# APP_URL: Die Domain / Basis-URL Ihrer Anwendung (z.B. https://ihredomain.com)
APP_URL="MY_APP_URL"

# ==========================================
# 2. HOSTINGER E-MAIL / SMTP KONFIGURATION
# ==========================================
# Für den E-Mail-Versand (Therapeuten-Einladungen, Passwort-Reset etc.)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=therapie@homeopilot360.com
SMTP_PASSWORD=
FROM_EMAIL=therapie@homeopilot360.com
FROM_NAME=HomeoPilot 360

# Optionale Aliase (werden automatisch als Fallback für SMTP_USER / SMTP_PASSWORD verwendet):
# EMAIL_USER=therapie@homeopilot360.com
# EMAIL_PASS=

# Optional: Hostinger Mail API (falls Versand über REST API statt SMTP gewünscht ist):
# MAILBOX_API_TOKEN=
# MAILBOX_ID=

# ==========================================
# 3. ADMIN-ZUGANGSDATEN
# ==========================================
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_RESET_EMAIL=

